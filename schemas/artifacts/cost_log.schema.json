{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/cost_log",
  "title": "Cost Log",
  "description": "Estimated, reserved, and actual spend by operation.",
  "type": "object",
  "required": ["version", "entries"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "budget_total_usd": { "type": "number", "minimum": 0 },
    "budget_reserved_usd": { "type": "number", "minimum": 0 },
    "budget_spent_usd": { "type": "number", "minimum": 0 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "tool", "operation", "status", "timestamp"],
        "properties": {
          "id": { "type": "string" },
          "tool": { "type": "string" },
          "operation": { "type": "string" },
          "status": { "type": "string", "enum": ["estimated", "reserved", "completed", "failed", "refunded"] },
          "estimated_usd": { "type": "number", "minimum": 0 },
          "reserved_usd": { "type": "number", "minimum": 0 },
          "actual_usd": { "type": "number", "minimum": 0 },
          "timestamp": { "type": "string", "format": "date-time" },
          "details": { "type": "string" },
          "shot_spec_revision": {
            "type": "integer",
            "minimum": 0
          },
          "compiled_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "asset_path",
                "sha256",
                "role"
              ],
              "properties": {
                "asset_path": {
                  "type": "string",
                  "maxLength": 2000
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "role": {
                  "enum": [
                    "identity",
                    "wardrobe",
                    "environment",
                    "style",
                    "composition",
                    "first_frame",
                    "last_frame",
                    "depth",
                    "pose"
                  ]
                },
                "subject_ref": {
                  "type": "string",
                  "maxLength": 200
                },
                "weight": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "parent_asset": {
                  "type": "string",
                  "maxLength": 2000
                },
                "read_only": {
                  "type": "boolean"
                },
                "source_artist": {
                  "type": "string",
                  "maxLength": 200
                },
                "origin_asset": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "additionalProperties": false
            },
            "maxItems": 100
          },
          "parent_asset": {
            "type": "string",
            "maxLength": 2000
          },
          "request_id": {
            "type": "string",
            "maxLength": 128
          },
          "budget_warning": {
            "type": "boolean"
          },
          "budget_warning_message": {
            "type": "string"
          },
          "asset_bindings": {
            "type": "array",
            "description": "Project-local asset bindings actually used for this generation; reusable source versions are pinned, never looked up by artist name.",
            "items": {
              "type": "object",
              "properties": {
                "alias": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "imported",
                    "private"
                  ]
                },
                "library_id": {
                  "type": "string"
                },
                "asset_id": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "snapshot_path": {
                  "type": "string"
                },
                "source_lineage": {
                  "type": "object"
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": { "type": "object" },
    "approved_tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
